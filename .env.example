APP_USERNAME=local
# Replace before starting. The application refuses change-me.
APP_PASSWORD=change-me
SESSION_TTL_SECONDS=1800
OCR_LANGUAGES=deu+eng
MAX_FILE_MB=20
MAX_BATCH_MB=80
MAX_PAGES=60
MAX_DOCUMENTS=10

# Optional accounts use /data in Compose (persistent account-data volume).
# Native development defaults to .local/account-data; set APP_DATA_DIR to override.
